# Copy to .env and fill in. .env is ignored by git; keep it out of backups you share.
# Public host name (Let's Encrypt) or "localhost" for a local test with Caddy's own CA.
ARGUS_SITE=localhost
# Dashboard login. Create the hash with:
#   docker run --rm caddy:2.11.7-alpine caddy hash-password --plaintext 'your-password'
ARGUS_USER=operator
# Double every $ of the hash in this file ($$) so that Compose does not expand it.
ARGUS_PASSWORD_HASH=
# Bearer token for machine clients of POST /api/ingest/equipment (empty keeps it disabled).
ARGUS_INGEST_TOKEN=
# Ports published on the host (change when 80 or 443 are taken).
ARGUS_HTTP_PORT=80
ARGUS_HTTPS_PORT=443
